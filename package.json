{
	"name": "core-service",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"build": "tsc --project tsconfig.json && tsc-alias",
		"start": "node dist/server.js",
		"prepare": "husky",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"lint-staged": {
		"**/*.{ts,js,json}": [
			"biome check --write"
		]
	},
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/node": "^25.5.2",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/error": "^4.2.0",
		"dotenv": "^17.4.1",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.8.4",
		"fastify-type-provider-zod": "^6.1.0",
		"pg": "^8.20.0",
		"zod": "^4.3.6"
	}
}
